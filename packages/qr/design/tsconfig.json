{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node20",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": ["*.ts"],
  "exclude": ["node.test.ts"]
}
